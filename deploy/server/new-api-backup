#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly backup_root="/var/backups/new-api"
readonly legacy_compose_file="/opt/new-api/compose.yaml"
readonly application_compose_file="/opt/new-api/compose.application.yaml"
readonly worker_compose_file="/opt/new-api/compose.worker.yaml"
readonly production_env="/etc/new-api/production.env"
readonly release_env="/var/lib/new-api/release.env"
readonly active_color_file="/var/lib/new-api/active-color"
readonly postgres_container="postgres"
readonly legacy_companion_containers=(
  "new-api-companion"
  "new-api-leaderboard-leaderboard-1"
)
readonly lock_file="/run/lock/new-api-backup.lock"

backup_mode="online"
case "${1:-}" in
  --offline) backup_mode="offline" ;;
  "") ;;
  *)
    echo "usage: new-api-backup [--offline]" >&2
    exit 2
    ;;
esac

if [[ ! -r "${production_env}" ]]; then
  echo "production environment is not installed" >&2
  exit 2
fi

# shellcheck disable=SC1090 # Root-owned deployment environment is trusted.
source "${production_env}"
if [[ -r "${release_env}" ]]; then
  # shellcheck disable=SC1090 # Root-owned release metadata is trusted.
  source "${release_env}"
fi
: "${POSTGRES_USER:?POSTGRES_USER is required}"
: "${POSTGRES_DB:?POSTGRES_DB is required}"
: "${CORE_IMAGE:?CORE_IMAGE is required}"
readonly leaderboard_data_volume="${LEADERBOARD_DATA_VOLUME:-new-api-leaderboard_leaderboard-data}"

active_color=""
core_container="new-api"
web_container="new-api-web"
if [[ -r "${active_color_file}" ]]; then
  active_color="$(tr -d '[:space:]' <"${active_color_file}")"
  case "${active_color}" in
    blue|green)
      core_container="new-api-${active_color}"
      web_container="new-api-web-${active_color}"
      ;;
    *)
      echo "invalid active color in ${active_color_file}" >&2
      exit 2
      ;;
  esac
fi

if [[ "${backup_mode}" == "offline" ]]; then
  for application_container in \
    new-api new-api-web new-api-worker \
    new-api-blue new-api-web-blue \
    new-api-green new-api-web-green; do
    if [[ "$(docker inspect "${application_container}" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]]; then
      echo "offline backup requires stopped application container: ${application_container}" >&2
      exit 3
    fi
  done
fi

exec 8>"${lock_file}"
if ! flock --wait 300 8; then
  echo "another backup is still running" >&2
  exit 3
fi

timestamp="$(TZ=Asia/Shanghai date +%Y%m%d-%H%M%S)"
temporary_dir="${backup_root}/.new-api-${timestamp}.tmp"
final_dir="${backup_root}/new-api-${timestamp}"
if [[ "${backup_mode}" == "offline" ]]; then
  final_dir="${final_dir}-offline"
fi
paused_containers=()

# shellcheck disable=SC2329 # Invoked indirectly by the EXIT trap.
cleanup() {
  local container=""

  for container in "${paused_containers[@]}"; do
    docker unpause "${container}" >/dev/null 2>&1 || true
  done
  if [[ -d "${temporary_dir}" ]]; then
    find "${temporary_dir}" -depth -delete
  fi
}
trap cleanup EXIT

install -d -m 0700 "${backup_root}"
install -d -m 0700 "${temporary_dir}"

docker inspect "${postgres_container}" >/dev/null
docker exec "${postgres_container}" \
  pg_isready -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" >/dev/null

docker exec "${postgres_container}" \
  pg_dump -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" \
  --format=custom --compress=6 --no-owner --no-acl \
  >"${temporary_dir}/database.dump"

docker exec -i "${postgres_container}" pg_restore --list \
  <"${temporary_dir}/database.dump" \
  >"${temporary_dir}/database.contents"
(
  cd "${temporary_dir}"
  sha256sum database.dump >database.dump.sha256
)

docker volume inspect "${leaderboard_data_volume}" >/dev/null
for container in "${legacy_companion_containers[@]}"; do
  if [[ "$(docker inspect "${container}" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]] && \
    [[ "$(docker inspect "${container}" --format '{{.State.Paused}}' 2>/dev/null || true)" != "true" ]]; then
    docker pause "${container}" >/dev/null
    paused_containers+=("${container}")
  fi
done

docker run --rm --network none \
  --entrypoint /bin/sh \
  --mount "type=volume,source=${leaderboard_data_volume},target=/source,readonly" \
  --mount "type=bind,source=${temporary_dir},target=/backup" \
  "${CORE_IMAGE}" \
  -c 'test -s /source/leaderboard.db && tar -C /source -cf /backup/leaderboard-data.tar .'
chmod 0600 "${temporary_dir}/leaderboard-data.tar"
if ! tar -tf "${temporary_dir}/leaderboard-data.tar" ./leaderboard.db >/dev/null; then
  echo "preserved leaderboard database is missing from the archive" >&2
  exit 3
fi
(
  cd "${temporary_dir}"
  sha256sum leaderboard-data.tar >leaderboard-data.tar.sha256
)

for container in "${paused_containers[@]}"; do
  docker unpause "${container}" >/dev/null
done
paused_containers=()

install -m 0600 "${legacy_compose_file}" "${temporary_dir}/compose.yaml"
if [[ -f "${application_compose_file}" ]]; then
  install -m 0600 "${application_compose_file}" "${temporary_dir}/compose.application.yaml"
fi
if [[ -f "${worker_compose_file}" ]]; then
  install -m 0600 "${worker_compose_file}" "${temporary_dir}/compose.worker.yaml"
fi
install -m 0600 "${production_env}" "${temporary_dir}/production.env"
if [[ -f "${release_env}" ]]; then
  install -m 0600 "${release_env}" "${temporary_dir}/release.env"
fi

{
  printf 'created_at=%s\n' "$(TZ=Asia/Shanghai date --iso-8601=seconds)"
  printf 'backup_mode=%s\n' "${backup_mode}"
  if [[ "${backup_mode}" == "offline" ]]; then
    printf 'application_containers_stopped=true\n'
  fi
  if [[ -n "${active_color}" ]]; then
    printf 'active_color=%s\n' "${active_color}"
  fi
  printf 'database=%s\n' "${POSTGRES_DB}"
  printf 'database_user=%s\n' "${POSTGRES_USER}"
  docker exec "${postgres_container}" psql \
    -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" -Atc \
    "SELECT 'database_bytes=' || pg_database_size(current_database());"
  docker inspect "${core_container}" --format 'core_image={{.Config.Image}}'
  docker inspect "${core_container}" --format 'core_image_id={{.Image}}'
  if docker inspect "${web_container}" >/dev/null 2>&1; then
    docker inspect "${web_container}" --format 'app_image={{.Config.Image}}'
    docker inspect "${web_container}" --format 'app_image_id={{.Image}}'
  fi
  if docker inspect new-api-worker >/dev/null 2>&1; then
    docker inspect new-api-worker --format 'worker_image={{.Config.Image}}'
    docker inspect new-api-worker --format 'worker_image_id={{.Image}}'
  fi
  printf 'legacy_sqlite_volume=%s\n' "${leaderboard_data_volume}"
  printf 'legacy_sqlite_archive_bytes=%s\n' "$(wc -c <"${temporary_dir}/leaderboard-data.tar")"
  docker inspect postgres --format 'postgres_image={{.Config.Image}}'
  docker inspect redis --format 'redis_image={{.Config.Image}}'
} >"${temporary_dir}/metadata.txt"

touch "${temporary_dir}/COMPLETE"
mv "${temporary_dir}" "${final_dir}"
trap - EXIT

find "${backup_root}" -mindepth 1 -maxdepth 1 -type d \
  -name 'new-api-*' -mtime +14 -exec sh -c '
    for directory do
      find "$directory" -depth -delete
    done
  ' sh {} +

printf 'Backup completed: %s\n' "${final_dir}"
