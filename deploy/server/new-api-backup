#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly backup_root="/var/backups/new-api"
readonly compose_file="/opt/new-api/compose.yaml"
readonly production_env="/etc/new-api/production.env"
readonly release_env="/var/lib/new-api/release.env"
readonly postgres_container="postgres"

if [[ ! -r "${production_env}" ]]; then
  echo "production environment is not installed" >&2
  exit 2
fi

# shellcheck disable=SC1090 # Root-owned deployment environment is trusted.
source "${production_env}"
: "${POSTGRES_USER:?POSTGRES_USER is required}"
: "${POSTGRES_DB:?POSTGRES_DB is required}"

timestamp="$(TZ=Asia/Shanghai date +%Y%m%d-%H%M%S)"
temporary_dir="${backup_root}/.new-api-${timestamp}.tmp"
final_dir="${backup_root}/new-api-${timestamp}"

# shellcheck disable=SC2329 # Invoked indirectly by the EXIT trap.
cleanup_temporary_dir() {
  if [[ -d "${temporary_dir}" ]]; then
    find "${temporary_dir}" -depth -delete
  fi
}
trap cleanup_temporary_dir EXIT

install -d -m 0700 "${backup_root}"
install -d -m 0700 "${temporary_dir}"

docker inspect "${postgres_container}" >/dev/null
docker exec "${postgres_container}" \
  pg_isready -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" >/dev/null

docker exec "${postgres_container}" \
  pg_dump -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" \
  --format=custom --compress=6 --no-owner --no-acl \
  >"${temporary_dir}/database.dump"

docker exec -i "${postgres_container}" pg_restore --list \
  <"${temporary_dir}/database.dump" \
  >"${temporary_dir}/database.contents"
sha256sum "${temporary_dir}/database.dump" \
  >"${temporary_dir}/database.dump.sha256"

install -m 0600 "${compose_file}" "${temporary_dir}/compose.yaml"
install -m 0600 "${production_env}" "${temporary_dir}/production.env"
if [[ -f "${release_env}" ]]; then
  install -m 0600 "${release_env}" "${temporary_dir}/release.env"
fi

{
  printf 'created_at=%s\n' "$(TZ=Asia/Shanghai date --iso-8601=seconds)"
  printf 'database=%s\n' "${POSTGRES_DB}"
  printf 'database_user=%s\n' "${POSTGRES_USER}"
  docker exec "${postgres_container}" psql \
    -U "${POSTGRES_USER}" -d "${POSTGRES_DB}" -Atc \
    "SELECT 'database_bytes=' || pg_database_size(current_database());"
  docker inspect new-api --format 'new_api_image={{.Config.Image}}'
  docker inspect new-api --format 'new_api_image_id={{.Image}}'
  docker inspect postgres --format 'postgres_image={{.Config.Image}}'
  docker inspect redis --format 'redis_image={{.Config.Image}}'
} >"${temporary_dir}/metadata.txt"

touch "${temporary_dir}/COMPLETE"
mv "${temporary_dir}" "${final_dir}"
trap - EXIT

find "${backup_root}" -mindepth 1 -maxdepth 1 -type d \
  -name 'new-api-*' -mtime +14 -exec sh -c '
    for directory do
      find "$directory" -depth -delete
    done
  ' sh {} +

printf 'Backup completed: %s\n' "${final_dir}"
