POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME_TO_A_URL_SAFE_SECRET
POSTGRES_DB=new-api
REDIS_PASSWORD=CHANGE_ME_TO_A_URL_SAFE_SECRET

# Bootstrap Core image used before the first managed custom release. The manual
# deployment command records later Core and App digests together in release.env.
CORE_IMAGE=calciumion/new-api@sha256:bacbbfbed64b4579213316e0ed78415985223bb20c47fbc24572dd7be5aa1695

TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=new-api-node-1

SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://example.com
# Core receives requests from the Web/Gateway over the Docker private network.
# Keep the subnet aligned with the external `backend` network on the host.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
CORE_LEADERBOARD_MIGRATION_REQUIRED=true

# Preserved legacy SQLite database. Core does not write this volume; it remains
# mounted read-only by the one-time migration tool and included in backups.
LEADERBOARD_DATA_VOLUME=new-api-leaderboard_leaderboard-data
LEADERBOARD_EXCLUDED_USER_IDS=
SPONSOR_MIN_AMOUNT=1
SPONSOR_MAX_AMOUNT=1000
LOTTERY_ENABLED=true
LOTTERY_PRIZES=
