POSTGRES_USER=root
POSTGRES_PASSWORD=CHANGE_ME_TO_A_URL_SAFE_SECRET
POSTGRES_DB=new-api
REDIS_PASSWORD=CHANGE_ME_TO_A_URL_SAFE_SECRET

# Bootstrap Core image used before the first managed custom release. The manual
# deployment command records later Core and App digests together in release.env.
CORE_IMAGE=calciumion/new-api@sha256:bacbbfbed64b4579213316e0ed78415985223bb20c47fbc24572dd7be5aa1695

TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true
NODE_NAME=new-api-node-1

SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=https://example.com
# Core receives requests from the Web/Gateway over the Docker private network.
# Keep the subnet aligned with the external `backend` network on the host.
TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# Companion backend. Keep the existing production volume name during the
# first decoupled cutover so the SQLite database is reused in place.
LEADERBOARD_DATA_VOLUME=new-api-leaderboard_leaderboard-data
COMPANION_PUBLIC_URL=https://example.com/leaderboard
NEW_API_PUBLIC_URL=https://example.com
LEADERBOARD_BASE_PATH=/leaderboard
MODEL_STATUS_BASE_PATH=/modelstatus
LOTTERY_SITE_BASE_PATH=/lottery
NEW_API_ROOT_ACCESS_TOKEN=CHANGE_ME_TO_A_ROOT_ACCESS_TOKEN
NEW_API_ROOT_USER_ID=1
NEW_API_REQUEST_TIMEOUT_MS=12000
NEW_API_QUOTA_PER_UNIT=500000
LEADERBOARD_TIME_ZONE=Asia/Shanghai
LEADERBOARD_SYNC_INTERVAL_MINUTES=5
LEADERBOARD_ALL_START_TIMESTAMP=1
LEADERBOARD_EXCLUDED_USER_IDS=
SPONSOR_MIN_AMOUNT=1
SPONSOR_MAX_AMOUNT=1000
SUPPORT_ACTIVITY_ACTIVE_DAYS=3
SUPPORT_ACTIVITY_START_TIMESTAMP=1784217600
RANK_SYSTEM_START_TIMESTAMP=1784304000
POSTPAID_SYNC_INTERVAL_SECONDS=30
LOTTERY_ENABLED=true
LOTTERY_PRIZES=
LOTTERY_FULFILLMENT_INTERVAL_SECONDS=15
LOTTERY_REDEMPTION_INTERVAL_SECONDS=60
