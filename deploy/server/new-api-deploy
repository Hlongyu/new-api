#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly compose_file="/opt/new-api/compose.yaml"
readonly production_env="/etc/new-api/production.env"
readonly state_root="/var/lib/new-api"
readonly release_env="${state_root}/release.env"
readonly release_root="${state_root}/releases"
readonly lock_file="/run/lock/new-api-deploy.lock"
readonly image_pattern='^ghcr\.io/hlongyu/new-api@sha256:[0-9a-f]{64}$'
readonly revision_pattern='^[0-9a-f]{40}$'
readonly actor_pattern='^[A-Za-z0-9-]+$'
readonly companion_container="new-api-companion"
readonly legacy_companion_container="new-api-leaderboard-leaderboard-1"
readonly legacy_update_timer="new-api-leaderboard-update.timer"

candidate_image="${1:-}"
release_revision="${2:-}"
registry_user="${3:-}"

if [[ ! "${candidate_image}" =~ ${image_pattern} ]]; then
  echo "invalid candidate image" >&2
  exit 2
fi
if [[ ! "${release_revision}" =~ ${revision_pattern} ]]; then
  echo "invalid release revision" >&2
  exit 2
fi
if [[ ! "${registry_user}" =~ ${actor_pattern} ]]; then
  echo "invalid registry user" >&2
  exit 2
fi
if [[ ! -r "${compose_file}" || ! -r "${production_env}" ]]; then
  echo "production configuration is not installed" >&2
  exit 2
fi

exec 9>"${lock_file}"
if ! flock -n 9; then
  echo "another deployment is already running" >&2
  exit 3
fi

docker_config="$(mktemp -d /run/new-api-deploy-docker.XXXXXX)"
candidate_env=""

# shellcheck disable=SC2329 # Invoked indirectly by the EXIT trap.
cleanup() {
  if [[ -n "${candidate_env}" && -f "${candidate_env}" ]]; then
    rm -f -- "${candidate_env}"
  fi
  if [[ -d "${docker_config}" ]]; then
    find "${docker_config}" -depth -delete
  fi
}
trap cleanup EXIT

if ! IFS= read -r registry_token || [[ -z "${registry_token}" ]]; then
  echo "missing registry token" >&2
  exit 2
fi

install -d -m 0700 "${release_root}"

release_image() {
  sed -n 's/^NEW_API_IMAGE=//p' "${release_env}"
}

release_revision_value() {
  sed -n 's/^RELEASE_REVISION=//p' "${release_env}"
}

release_deployed_at() {
  local deployed_at

  deployed_at="$(sed -n 's/^RELEASE_DEPLOYED_AT=//p' "${release_env}")"
  printf '%s\n' "${deployed_at:-0}"
}

compose() {
  local image
  local revision
  local deployed_at

  image="$(release_image)"
  revision="$(release_revision_value)"
  deployed_at="$(release_deployed_at)"
  if [[ -z "${image}" ]]; then
    echo "release image is not configured" >&2
    return 1
  fi

  NEW_API_IMAGE="${image}" \
    RELEASE_REVISION="${revision}" \
    RELEASE_DEPLOYED_AT="${deployed_at}" \
    docker compose \
    --project-name new-api \
    --env-file "${production_env}" \
    -f "${compose_file}" \
    "$@"
}

write_release_env() {
  local image="$1"
  local revision="$2"
  local deployed_at="${3:-0}"

  candidate_env="$(mktemp "${state_root}/.release.env.XXXXXX")"
  {
    printf 'NEW_API_IMAGE=%s\n' "${image}"
    printf 'RELEASE_REVISION=%s\n' "${revision}"
    printf 'RELEASE_DEPLOYED_AT=%s\n' "${deployed_at}"
  } >"${candidate_env}"
  chmod 0600 "${candidate_env}"
  mv -f -- "${candidate_env}" "${release_env}"
  candidate_env=""
}

wait_for_main_health() {
  local main_health=""
  local main_state=""

  for _ in $(seq 1 75); do
    main_state="$(docker inspect new-api --format '{{.State.Status}}' 2>/dev/null || true)"
    main_health="$(docker inspect new-api --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null || true)"
    if [[ "${main_state}" == "running" && "${main_health}" == "healthy" ]]; then
      if curl --fail --silent --show-error --max-time 5 \
        http://127.0.0.1:3000/api/status >/dev/null; then
        return 0
      fi
    fi
    if [[ "${main_state}" == "dead" || "${main_state}" == "exited" ]]; then
      break
    fi
    sleep 2
  done

  docker inspect new-api --format 'state={{.State.Status}} health={{if .State.Health}}{{.State.Health.Status}}{{end}}' >&2 || true
  return 1
}

wait_for_health() {
  local main_health=""
  local main_state=""
  local companion_health=""
  local companion_response=""
  local companion_state=""
  local expected_revision=""

  expected_revision="$(release_revision_value)"

  for _ in $(seq 1 75); do
    main_state="$(docker inspect new-api --format '{{.State.Status}}' 2>/dev/null || true)"
    main_health="$(docker inspect new-api --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null || true)"
    companion_state="$(docker inspect "${companion_container}" --format '{{.State.Status}}' 2>/dev/null || true)"
    companion_health="$(docker inspect "${companion_container}" --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null || true)"
    if [[ "${main_state}" == "running" && "${main_health}" == "healthy" && \
      "${companion_state}" == "running" && "${companion_health}" == "healthy" ]]; then
      companion_response="$(curl --fail --silent --show-error --max-time 5 \
        http://127.0.0.1:8787/healthz || true)"
      if curl --fail --silent --show-error --max-time 5 \
        http://127.0.0.1:3000/api/status >/dev/null && \
        grep -Fq "\"commit\":\"${expected_revision}\"" <<<"${companion_response}"; then
        return 0
      fi
    fi
    if [[ "${main_state}" == "dead" || "${main_state}" == "exited" || \
      "${companion_state}" == "dead" || "${companion_state}" == "exited" ]]; then
      break
    fi
    sleep 2
  done

  docker inspect new-api --format 'main_state={{.State.Status}} main_health={{if .State.Health}}{{.State.Health.Status}}{{end}}' >&2 || true
  docker inspect "${companion_container}" --format 'companion_state={{.State.Status}} companion_health={{if .State.Health}}{{.State.Health.Status}}{{end}}' >&2 || true
  return 1
}

wait_for_legacy_companion() {
  for _ in $(seq 1 30); do
    if curl --fail --silent --show-error --max-time 5 \
      http://127.0.0.1:8787/healthz >/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

printf '%s\n' "${registry_token}" | docker --config "${docker_config}" login \
  ghcr.io --username "${registry_user}" --password-stdin >/dev/null
registry_token=""

docker --config "${docker_config}" pull "${candidate_image}"

actual_revision="$(docker image inspect "${candidate_image}" \
  --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')"
if [[ "${actual_revision}" != "${release_revision}" ]]; then
  echo "image revision does not match requested release" >&2
  exit 4
fi

if ! docker run --rm --network none --entrypoint node "${candidate_image}" \
  --check /opt/new-api/companion/src/server.js >/dev/null; then
  echo "candidate image does not contain a valid companion backend" >&2
  exit 4
fi

if ! systemctl start new-api-backup.service; then
  echo "pre-deployment database backup failed" >&2
  exit 5
fi

if [[ ! -f "${release_env}" ]]; then
  current_image="$(docker inspect new-api --format '{{.Config.Image}}')"
  current_revision="$(docker image inspect "${current_image}" \
    --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' 2>/dev/null || true)"
  write_release_env "${current_image}" "${current_revision:-unknown}" 0
fi

timestamp="$(date --utc +%Y%m%dT%H%M%SZ)"
release_dir="${release_root}/${timestamp}-${release_revision}"
install -d -m 0700 "${release_dir}"
install -m 0600 "${release_env}" "${release_dir}/previous.env"

previous_image="$(release_image)"
if [[ -z "${previous_image}" ]] || ! docker image inspect "${previous_image}" >/dev/null 2>&1; then
  echo "previous image is not available for rollback" >&2
  exit 6
fi

initial_cutover=false
legacy_was_running=false
previous_supports_companion=false
if docker run --rm --network none --entrypoint node "${previous_image}" \
  --check /opt/new-api/companion/src/server.js >/dev/null 2>&1; then
  previous_supports_companion=true
fi
if [[ "${previous_supports_companion}" != "true" ]] || \
  ! docker inspect "${companion_container}" >/dev/null 2>&1; then
  initial_cutover=true
  if [[ "$(docker inspect "${legacy_companion_container}" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]]; then
    legacy_was_running=true
    if systemctl is-active --quiet "${legacy_update_timer}"; then
      echo "disable ${legacy_update_timer} before the first unified cutover" >&2
      exit 6
    fi
  fi
fi

write_release_env "${candidate_image}" "${release_revision}" "$(date +%s)"
compose config --quiet

if [[ "${legacy_was_running}" == "true" ]]; then
  docker stop --time 30 "${legacy_companion_container}"
fi

if compose up -d --no-deps --force-recreate --pull never new-api companion && wait_for_health; then
  install -m 0600 "${release_env}" "${release_dir}/deployed.env"
  {
    printf 'deployed_at=%s\n' "$(date --utc --iso-8601=seconds)"
    printf 'deployed_by=%s\n' "${registry_user}"
    printf 'release_revision=%s\n' "${release_revision}"
    printf 'image=%s\n' "${candidate_image}"
    printf 'initial_unified_cutover=%s\n' "${initial_cutover}"
  } >"${release_dir}/manifest.env"
  touch "${release_dir}/SUCCESS"
  logger -t new-api-deploy "deployed revision ${release_revision}"
  exit 0
fi

echo "candidate failed health checks; rolling back image" >&2
candidate_env="$(mktemp "${state_root}/.release.env.XXXXXX")"
install -m 0600 "${release_dir}/previous.env" "${candidate_env}"
mv -f -- "${candidate_env}" "${release_env}"
candidate_env=""

compose config --quiet
if [[ "${initial_cutover}" == "true" ]]; then
  compose stop companion >/dev/null 2>&1 || true
  compose rm -f companion >/dev/null 2>&1 || true
  compose up -d --no-deps --force-recreate --pull never new-api
  rollback_healthy=false
  if wait_for_main_health; then
    if [[ "${legacy_was_running}" == "true" ]]; then
      docker start "${legacy_companion_container}" >/dev/null
      if wait_for_legacy_companion; then rollback_healthy=true; fi
    else
      rollback_healthy=true
    fi
  fi
else
  compose up -d --no-deps --force-recreate --pull never new-api companion
  rollback_healthy=false
  if wait_for_health; then rollback_healthy=true; fi
fi
if [[ "${rollback_healthy}" != "true" ]]; then
  touch "${release_dir}/ROLLBACK_FAILED"
  logger -p user.err -t new-api-deploy "rollback failed after revision ${release_revision}"
  exit 8
fi

touch "${release_dir}/ROLLED_BACK"
logger -p user.warning -t new-api-deploy "rolled back revision ${release_revision}"
exit 7
