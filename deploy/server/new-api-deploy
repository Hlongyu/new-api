#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly compose_file="/opt/new-api/compose.yaml"
readonly production_env="/etc/new-api/production.env"
readonly state_root="/var/lib/new-api"
readonly release_env="${state_root}/release.env"
readonly release_root="${state_root}/releases"
readonly lock_file="/run/lock/new-api-deploy.lock"
readonly app_image_pattern='^ghcr\.io/hlongyu/new-api-app@sha256:[0-9a-f]{64}$'
readonly revision_pattern='^[0-9a-f]{40}$'
readonly actor_pattern='^[A-Za-z0-9-]+$'
readonly web_container="new-api-web"
readonly companion_container="new-api-companion"
readonly previous_companion_container="new-api-companion-previous"
readonly legacy_companion_container="new-api-leaderboard-leaderboard-1"
readonly legacy_update_timer="new-api-leaderboard-update.timer"

candidate_app_image="${1:-}"
app_release_revision="${2:-}"
registry_user="${3:-}"

if [[ ! "${candidate_app_image}" =~ ${app_image_pattern} ]]; then
  echo "invalid candidate app image" >&2
  exit 2
fi
if [[ ! "${app_release_revision}" =~ ${revision_pattern} ]]; then
  echo "invalid app release revision" >&2
  exit 2
fi
if [[ ! "${registry_user}" =~ ${actor_pattern} ]]; then
  echo "invalid registry user" >&2
  exit 2
fi
if [[ ! -r "${compose_file}" || ! -r "${production_env}" ]]; then
  echo "production configuration is not installed" >&2
  exit 2
fi

exec 9>"${lock_file}"
if ! flock -n 9; then
  echo "another deployment is already running" >&2
  exit 3
fi

docker_config="$(mktemp -d /run/new-api-deploy-docker.XXXXXX)"
candidate_env=""

# shellcheck disable=SC2329 # Invoked indirectly by the EXIT trap.
cleanup() {
  if [[ -n "${candidate_env}" && -f "${candidate_env}" ]]; then
    rm -f -- "${candidate_env}"
  fi
  if [[ -d "${docker_config}" ]]; then
    find "${docker_config}" -depth -delete
  fi
}
trap cleanup EXIT

if ! IFS= read -r registry_token || [[ -z "${registry_token}" ]]; then
  echo "missing registry token" >&2
  exit 2
fi

install -d -m 0700 "${release_root}"

app_image() {
  sed -n 's/^APP_IMAGE=//p' "${release_env}"
}

app_revision() {
  sed -n 's/^APP_RELEASE_REVISION=//p' "${release_env}"
}

app_deployed_at() {
  local deployed_at

  deployed_at="$(sed -n 's/^APP_RELEASE_DEPLOYED_AT=//p' "${release_env}")"
  printf '%s\n' "${deployed_at:-0}"
}

compose() {
  local image
  local revision
  local deployed_at

  image="$(app_image)"
  revision="$(app_revision)"
  deployed_at="$(app_deployed_at)"
  if [[ -z "${image}" ]]; then
    echo "app release image is not configured" >&2
    return 1
  fi

  APP_IMAGE="${image}" \
    APP_RELEASE_REVISION="${revision}" \
    APP_RELEASE_DEPLOYED_AT="${deployed_at}" \
    docker compose \
    --project-name new-api \
    --env-file "${production_env}" \
    -f "${compose_file}" \
    "$@"
}

write_release_env() {
  local image="$1"
  local revision="$2"
  local deployed_at="${3:-0}"

  candidate_env="$(mktemp "${state_root}/.release.env.XXXXXX")"
  {
    printf 'APP_IMAGE=%s\n' "${image}"
    printf 'APP_RELEASE_REVISION=%s\n' "${revision}"
    printf 'APP_RELEASE_DEPLOYED_AT=%s\n' "${deployed_at}"
  } >"${candidate_env}"
  chmod 0600 "${candidate_env}"
  mv -f -- "${candidate_env}" "${release_env}"
  candidate_env=""
}

wait_for_core_health() {
  for _ in $(seq 1 30); do
    if curl --fail --silent --show-error --max-time 5 \
      http://127.0.0.1:3000/api/status >/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

wait_for_companion_health() {
  local companion_health=""
  local companion_response=""
  local companion_state=""
  local expected_revision=""

  expected_revision="$(app_revision)"

  for _ in $(seq 1 75); do
    companion_state="$(docker inspect "${companion_container}" --format '{{.State.Status}}' 2>/dev/null || true)"
    companion_health="$(docker inspect "${companion_container}" --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null || true)"
    if [[ "${companion_state}" == "running" && "${companion_health}" == "healthy" ]]; then
      companion_response="$(curl --fail --silent --show-error --max-time 5 \
        http://127.0.0.1:8787/healthz || true)"
      if grep -Fq "\"commit\":\"${expected_revision}\"" <<<"${companion_response}"; then
        return 0
      fi
    fi
    if [[ "${companion_state}" == "dead" || "${companion_state}" == "exited" ]]; then
      break
    fi
    sleep 2
  done

  docker inspect "${companion_container}" --format 'companion_state={{.State.Status}} companion_health={{if .State.Health}}{{.State.Health.Status}}{{end}}' >&2 || true
  return 1
}

wait_for_app_health() {
  local web_health=""
  local web_state=""
  local companion_health=""
  local companion_response=""
  local companion_state=""
  local expected_revision=""

  expected_revision="$(app_revision)"

  for _ in $(seq 1 75); do
    web_state="$(docker inspect "${web_container}" --format '{{.State.Status}}' 2>/dev/null || true)"
    web_health="$(docker inspect "${web_container}" --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null || true)"
    companion_state="$(docker inspect "${companion_container}" --format '{{.State.Status}}' 2>/dev/null || true)"
    companion_health="$(docker inspect "${companion_container}" --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null || true)"
    if [[ "${web_state}" == "running" && "${web_health}" == "healthy" && \
      "${companion_state}" == "running" && "${companion_health}" == "healthy" ]]; then
      companion_response="$(curl --fail --silent --show-error --max-time 5 \
        http://127.0.0.1:3002/healthz || true)"
      if curl --fail --silent --show-error --max-time 5 \
        http://127.0.0.1:3002/api/status >/dev/null && \
        grep -Fq "\"commit\":\"${expected_revision}\"" <<<"${companion_response}"; then
        return 0
      fi
    fi
    if [[ "${web_state}" == "dead" || "${web_state}" == "exited" || \
      "${companion_state}" == "dead" || "${companion_state}" == "exited" ]]; then
      break
    fi
    sleep 2
  done

  docker inspect "${web_container}" --format 'web_state={{.State.Status}} web_health={{if .State.Health}}{{.State.Health.Status}}{{end}}' >&2 || true
  docker inspect "${companion_container}" --format 'companion_state={{.State.Status}} companion_health={{if .State.Health}}{{.State.Health.Status}}{{end}}' >&2 || true
  return 1
}

deploy_app_services() {
  compose up -d --no-deps --force-recreate --pull never companion
  wait_for_companion_health
  compose up -d --no-deps --force-recreate --pull never web
  wait_for_app_health
}

wait_for_legacy_companion() {
  for _ in $(seq 1 30); do
    if curl --fail --silent --show-error --max-time 5 \
      http://127.0.0.1:8787/healthz >/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

if ! wait_for_core_health; then
  echo "official Core is not healthy; refusing to deploy the custom app" >&2
  exit 4
fi

printf '%s\n' "${registry_token}" | docker --config "${docker_config}" login \
  ghcr.io --username "${registry_user}" --password-stdin >/dev/null
registry_token=""

docker --config "${docker_config}" pull "${candidate_app_image}"

actual_revision="$(docker image inspect "${candidate_app_image}" \
  --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')"
if [[ "${actual_revision}" != "${app_release_revision}" ]]; then
  echo "app image revision does not match requested release" >&2
  exit 4
fi

if ! docker run --rm --network none --entrypoint node "${candidate_app_image}" \
  --check /opt/new-api/companion/src/server.js >/dev/null; then
  echo "candidate image does not contain a valid Companion backend" >&2
  exit 4
fi
if ! docker run --rm --network none \
  --read-only \
  --tmpfs /tmp:rw,mode=1777 \
  --tmpfs /var/lib/nginx:rw,mode=0755 \
  --add-host new-api:127.0.0.1 --add-host companion:127.0.0.1 \
  --entrypoint nginx "${candidate_app_image}" -t >/dev/null; then
  echo "candidate image does not contain a valid Web/Gateway configuration" >&2
  exit 4
fi

if ! systemctl start new-api-backup.service; then
  echo "pre-deployment database backup failed" >&2
  exit 5
fi

had_release_env=false
if [[ -f "${release_env}" ]] && grep -q '^APP_IMAGE=' "${release_env}"; then
  had_release_env=true
fi

timestamp="$(date --utc +%Y%m%dT%H%M%SZ)"
release_dir="${release_root}/${timestamp}-${app_release_revision}"
install -d -m 0700 "${release_dir}"
if [[ "${had_release_env}" == "true" ]]; then
  previous_image="$(app_image)"
  if [[ -z "${previous_image}" ]] || ! docker image inspect "${previous_image}" >/dev/null 2>&1; then
    echo "previous app image is not available for rollback" >&2
    exit 6
  fi
  install -m 0600 "${release_env}" "${release_dir}/previous.env"
fi

initial_cutover=false
legacy_was_running=false
previous_companion_saved=false
previous_companion_present=false
previous_companion_was_running=false
if [[ "${had_release_env}" != "true" ]] || \
  ! docker inspect "${web_container}" >/dev/null 2>&1 || \
  ! docker inspect "${companion_container}" >/dev/null 2>&1; then
  initial_cutover=true
  if [[ "$(docker inspect "${legacy_companion_container}" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]]; then
    legacy_was_running=true
    if systemctl is-active --quiet "${legacy_update_timer}"; then
      echo "disable ${legacy_update_timer} before the first decoupled app cutover" >&2
      exit 6
    fi
  fi
  if [[ "${had_release_env}" != "true" ]] && docker inspect "${companion_container}" >/dev/null 2>&1; then
    if docker inspect "${previous_companion_container}" >/dev/null 2>&1; then
      echo "previous Companion preservation container already exists" >&2
      exit 6
    fi
    if [[ "$(docker inspect "${companion_container}" --format '{{.State.Running}}')" == "true" ]]; then
      previous_companion_was_running=true
    fi
    previous_companion_present=true
  fi
fi

write_release_env "${candidate_app_image}" "${app_release_revision}" "$(date +%s)"
if ! compose config --quiet; then
  if [[ "${had_release_env}" == "true" ]]; then
    candidate_env="$(mktemp "${state_root}/.release.env.XXXXXX")"
    install -m 0600 "${release_dir}/previous.env" "${candidate_env}"
    mv -f -- "${candidate_env}" "${release_env}"
    candidate_env=""
  else
    rm -f -- "${release_env}"
  fi
  exit 6
fi

if [[ "${legacy_was_running}" == "true" ]]; then
  docker stop --time 30 "${legacy_companion_container}"
fi
if [[ "${previous_companion_present}" == "true" ]]; then
  if [[ "${previous_companion_was_running}" == "true" ]]; then
    docker stop --time 30 "${companion_container}"
  fi
  docker rename "${companion_container}" "${previous_companion_container}"
  previous_companion_saved=true
fi

if deploy_app_services; then
  install -m 0600 "${release_env}" "${release_dir}/deployed.env"
  {
    printf 'deployed_at=%s\n' "$(date --utc --iso-8601=seconds)"
    printf 'deployed_by=%s\n' "${registry_user}"
    printf 'app_release_revision=%s\n' "${app_release_revision}"
    printf 'app_image=%s\n' "${candidate_app_image}"
    printf 'core_container_unchanged=true\n'
    printf 'initial_decoupled_cutover=%s\n' "${initial_cutover}"
  } >"${release_dir}/manifest.env"
  touch "${release_dir}/SUCCESS"
  logger -t new-api-deploy "deployed custom app revision ${app_release_revision}; Core unchanged"
  exit 0
fi

echo "candidate app failed health checks; rolling back custom services" >&2
if [[ "${had_release_env}" == "true" ]]; then
  candidate_env="$(mktemp "${state_root}/.release.env.XXXXXX")"
  install -m 0600 "${release_dir}/previous.env" "${candidate_env}"
  mv -f -- "${candidate_env}" "${release_env}"
  candidate_env=""
  compose config --quiet
  rollback_healthy=false
  if deploy_app_services; then rollback_healthy=true; fi
else
  compose stop web companion >/dev/null 2>&1 || true
  compose rm -f web companion >/dev/null 2>&1 || true
  rm -f -- "${release_env}"
  rollback_healthy=false
  if wait_for_core_health; then
    if [[ "${previous_companion_saved}" == "true" ]]; then
      docker rename "${previous_companion_container}" "${companion_container}"
      if [[ "${previous_companion_was_running}" == "true" ]]; then
        docker start "${companion_container}" >/dev/null
        if wait_for_legacy_companion; then rollback_healthy=true; fi
      else
        rollback_healthy=true
      fi
    elif [[ "${legacy_was_running}" == "true" ]]; then
      docker start "${legacy_companion_container}" >/dev/null
      if wait_for_legacy_companion; then rollback_healthy=true; fi
    else
      rollback_healthy=true
    fi
  fi
fi

if [[ "${rollback_healthy}" != "true" ]]; then
  touch "${release_dir}/ROLLBACK_FAILED"
  logger -p user.err -t new-api-deploy "custom app rollback failed after revision ${app_release_revision}"
  exit 8
fi

touch "${release_dir}/ROLLED_BACK"
logger -p user.warning -t new-api-deploy "rolled back custom app revision ${app_release_revision}; Core unchanged"
exit 7
