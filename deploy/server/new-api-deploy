#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

readonly compose_file="/opt/new-api/compose.yaml"
readonly production_env="/etc/new-api/production.env"
readonly state_root="/var/lib/new-api"
readonly release_env="${state_root}/release.env"
readonly release_root="${state_root}/releases"
readonly lock_file="/run/lock/new-api-deploy.lock"
readonly core_image_pattern='^ghcr\.io/hlongyu/new-api-core@sha256:[0-9a-f]{64}$'
readonly app_image_pattern='^ghcr\.io/hlongyu/new-api-app@sha256:[0-9a-f]{64}$'
readonly revision_pattern='^[0-9a-f]{40}$'
readonly actor_pattern='^[A-Za-z0-9-]+$'
readonly core_container="new-api"
readonly web_container="new-api-web"
readonly legacy_companion_containers=(
  "new-api-companion"
  "new-api-leaderboard-leaderboard-1"
)

candidate_core_image="${1:-}"
candidate_app_image="${2:-}"
release_revision="${3:-}"
registry_user="${4:-}"

if [[ ! "${candidate_core_image}" =~ ${core_image_pattern} ]]; then
  echo "invalid candidate Core image" >&2
  exit 2
fi
if [[ ! "${candidate_app_image}" =~ ${app_image_pattern} ]]; then
  echo "invalid candidate App image" >&2
  exit 2
fi
if [[ ! "${release_revision}" =~ ${revision_pattern} ]]; then
  echo "invalid release revision" >&2
  exit 2
fi
if [[ ! "${registry_user}" =~ ${actor_pattern} ]]; then
  echo "invalid registry user" >&2
  exit 2
fi
if [[ ! -r "${compose_file}" || ! -r "${production_env}" || ! -r "${release_env}" ]]; then
  echo "production configuration or current release state is not installed" >&2
  exit 2
fi

exec 9>"${lock_file}"
if ! flock -n 9; then
  echo "another deployment is already running" >&2
  exit 3
fi

docker_config="$(mktemp -d /run/new-api-deploy-docker.XXXXXX)"
candidate_env=""

# shellcheck disable=SC2329 # Invoked indirectly by the EXIT trap.
cleanup() {
  if [[ -n "${candidate_env}" && -f "${candidate_env}" ]]; then
    rm -f -- "${candidate_env}"
  fi
  if [[ -d "${docker_config}" ]]; then
    find "${docker_config}" -depth -delete
  fi
}
trap cleanup EXIT

if ! IFS= read -r registry_token || [[ -z "${registry_token}" ]]; then
  echo "missing registry token" >&2
  exit 2
fi

install -d -m 0700 "${release_root}"

release_value() {
  local key="$1"
  local file="$2"

  sed -n "s/^${key}=//p" "${file}" | tail -n 1
}

core_image() {
  local image=""

  image="$(release_value CORE_IMAGE "${release_env}")"
  if [[ -z "${image}" ]]; then
    image="$(release_value CORE_IMAGE "${production_env}")"
  fi
  printf '%s\n' "${image}"
}

app_image() {
  release_value APP_IMAGE "${release_env}"
}

app_revision() {
  release_value APP_RELEASE_REVISION "${release_env}"
}

app_deployed_at() {
  local deployed_at=""

  deployed_at="$(release_value APP_RELEASE_DEPLOYED_AT "${release_env}")"
  printf '%s\n' "${deployed_at:-0}"
}

compose() {
  local selected_app_image=""
  local selected_core_image=""
  local revision=""
  local deployed_at=""

  selected_core_image="$(core_image)"
  selected_app_image="$(app_image)"
  revision="$(app_revision)"
  deployed_at="$(app_deployed_at)"
  if [[ -z "${selected_core_image}" || -z "${selected_app_image}" ]]; then
    echo "release images are not configured" >&2
    return 1
  fi

  CORE_IMAGE="${selected_core_image}" \
    APP_IMAGE="${selected_app_image}" \
    APP_RELEASE_REVISION="${revision}" \
    APP_RELEASE_DEPLOYED_AT="${deployed_at}" \
    docker compose \
    --project-name new-api \
    --env-file "${production_env}" \
    -f "${compose_file}" \
    "$@"
}

write_release_env() {
  local selected_core_image="$1"
  local selected_app_image="$2"
  local revision="$3"
  local deployed_at="${4:-0}"

  candidate_env="$(mktemp "${state_root}/.release.env.XXXXXX")"
  {
    printf 'CORE_IMAGE=%s\n' "${selected_core_image}"
    printf 'APP_IMAGE=%s\n' "${selected_app_image}"
    printf 'APP_RELEASE_REVISION=%s\n' "${revision}"
    printf 'APP_RELEASE_DEPLOYED_AT=%s\n' "${deployed_at}"
  } >"${candidate_env}"
  chmod 0600 "${candidate_env}"
  mv -f -- "${candidate_env}" "${release_env}"
  candidate_env=""
}

write_previous_env() {
  local destination="$1"
  local selected_core_image="$2"
  local selected_app_image="$3"
  local revision="$4"
  local deployed_at="$5"

  {
    printf 'CORE_IMAGE=%s\n' "${selected_core_image}"
    printf 'APP_IMAGE=%s\n' "${selected_app_image}"
    printf 'APP_RELEASE_REVISION=%s\n' "${revision}"
    printf 'APP_RELEASE_DEPLOYED_AT=%s\n' "${deployed_at}"
  } >"${destination}"
  chmod 0600 "${destination}"
}

wait_for_core_health() {
  local attempts="${1:-150}"

  for _ in $(seq 1 "${attempts}"); do
    if curl --fail --silent --show-error --max-time 5 \
      http://127.0.0.1:3000/api/status >/dev/null; then
      return 0
    fi
    sleep 2
  done

  docker inspect "${core_container}" \
    --format 'core_state={{.State.Status}} core_health={{if .State.Health}}{{.State.Health.Status}}{{end}}' >&2 || true
  return 1
}

wait_for_app_health() {
  local web_health=""
  local web_state=""

  for _ in $(seq 1 75); do
    web_state="$(docker inspect "${web_container}" --format '{{.State.Status}}' 2>/dev/null || true)"
    web_health="$(docker inspect "${web_container}" --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}' 2>/dev/null || true)"
    if [[ "${web_state}" == "running" && "${web_health}" == "healthy" ]]; then
      if curl --fail --silent --show-error --max-time 5 \
        http://127.0.0.1:3002/api/status >/dev/null && \
        curl --fail --silent --show-error --max-time 5 \
          http://127.0.0.1:3002/healthz >/dev/null; then
        return 0
      fi
    fi
    if [[ "${web_state}" == "dead" || "${web_state}" == "exited" ]]; then
      break
    fi
    sleep 2
  done

  docker inspect "${web_container}" \
    --format 'web_state={{.State.Status}} web_health={{if .State.Health}}{{.State.Health.Status}}{{end}}' >&2 || true
  return 1
}

remove_legacy_companion_containers() {
  local container=""

  for container in "${legacy_companion_containers[@]}"; do
    if docker container inspect "${container}" >/dev/null 2>&1; then
      docker rm --force "${container}" >/dev/null
    fi
  done
}

deploy_release() {
  remove_legacy_companion_containers || return
  compose up -d --no-deps --force-recreate --pull never new-api || return
  wait_for_core_health || return
  compose up -d --no-deps --force-recreate --pull never web || return
  wait_for_app_health
}

validate_offline_backup() {
  local backup_dir=""

  backup_dir="$(find /var/backups/new-api -mindepth 1 -maxdepth 1 -type d \
    -name 'new-api-*-offline' -mmin -60 -printf '%T@ %p\n' 2>/dev/null | \
    sort -nr | head -n 1 | cut -d' ' -f2-)"
  if [[ -z "${backup_dir}" || ! -f "${backup_dir}/COMPLETE" ]]; then
    echo "a completed offline backup from the last hour is required" >&2
    return 1
  fi
  if ! grep -Fxq 'backup_mode=offline' "${backup_dir}/metadata.txt" || \
    ! grep -Fxq 'application_containers_stopped=true' "${backup_dir}/metadata.txt"; then
    echo "offline backup metadata is invalid" >&2
    return 1
  fi
  if ! (
    cd "${backup_dir}"
    sha256sum -c database.dump.sha256 >/dev/null
    if [[ -f leaderboard-data.tar.sha256 ]]; then
      sha256sum -c leaderboard-data.tar.sha256 >/dev/null
      tar -tf leaderboard-data.tar ./leaderboard.db >/dev/null
    else
      sha256sum -c leaderboard.db.sha256 >/dev/null
    fi
    test -s database.contents
  ); then
    echo "offline backup validation failed" >&2
    return 1
  fi

  printf '%s\n' "${backup_dir}"
}

current_core_image="$(core_image)"
current_app_image="$(app_image)"
current_revision="$(app_revision)"
current_deployed_at="$(app_deployed_at)"

if [[ -z "${current_core_image}" || -z "${current_app_image}" ]]; then
  echo "current Core and App images must be configured before deployment" >&2
  exit 4
fi
if ! docker image inspect "${current_core_image}" >/dev/null 2>&1; then
  echo "current Core image is not available for rollback" >&2
  exit 4
fi
if ! docker image inspect "${current_app_image}" >/dev/null 2>&1; then
  echo "current App image is not available for rollback" >&2
  exit 4
fi
application_mode="running"
running_application_containers=0
for container in "${core_container}" "${web_container}"; do
  if [[ "$(docker inspect "${container}" --format '{{.State.Running}}' 2>/dev/null || true)" == "true" ]]; then
    running_application_containers=$((running_application_containers + 1))
  fi
done
if [[ "${running_application_containers}" -eq 0 ]]; then
  application_mode="offline"
elif [[ "${running_application_containers}" -ne 2 ]]; then
  echo "application containers are only partially running; refusing deployment" >&2
  exit 4
elif ! wait_for_core_health 30; then
  echo "current Core is not healthy; refusing to start deployment" >&2
  exit 4
fi

printf '%s\n' "${registry_token}" | docker --config "${docker_config}" login \
  ghcr.io --username "${registry_user}" --password-stdin >/dev/null
registry_token=""

docker --config "${docker_config}" pull "${candidate_core_image}"
docker --config "${docker_config}" pull "${candidate_app_image}"

actual_core_revision="$(docker image inspect "${candidate_core_image}" \
  --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')"
actual_app_revision="$(docker image inspect "${candidate_app_image}" \
  --format '{{index .Config.Labels "org.opencontainers.image.revision"}}')"
if [[ "${actual_core_revision}" != "${release_revision}" ]]; then
  echo "Core image revision does not match requested release" >&2
  exit 4
fi
if [[ "${actual_app_revision}" != "${release_revision}" ]]; then
  echo "App image revision does not match requested release" >&2
  exit 4
fi

if ! docker run --rm --network none --entrypoint /bin/sh "${candidate_core_image}" \
  -c 'test -x /new-api && test -x /companion-migrate'; then
  echo "candidate Core image does not contain the required executables" >&2
  exit 4
fi
if ! docker run --rm --network none \
  --read-only \
  --tmpfs /tmp:rw,mode=1777 \
  --tmpfs /var/lib/nginx:rw,mode=0755 \
  --add-host new-api:127.0.0.1 \
  --entrypoint nginx "${candidate_app_image}" -t >/dev/null; then
  echo "candidate App image does not contain a valid Web/Gateway configuration" >&2
  exit 4
fi

predeployment_backup=""
if [[ "${application_mode}" == "offline" ]]; then
  if ! predeployment_backup="$(validate_offline_backup)"; then
    exit 5
  fi
else
  if ! systemctl start new-api-backup.service; then
    echo "pre-deployment database backup failed" >&2
    exit 5
  fi
  predeployment_backup="online backup completed by new-api-backup.service"
fi

timestamp="$(date --utc +%Y%m%dT%H%M%SZ)"
release_dir="${release_root}/${timestamp}-${release_revision}"
install -d -m 0700 "${release_dir}"
write_previous_env \
  "${release_dir}/previous.env" \
  "${current_core_image}" \
  "${current_app_image}" \
  "${current_revision}" \
  "${current_deployed_at}"

write_release_env \
  "${candidate_core_image}" \
  "${candidate_app_image}" \
  "${release_revision}" \
  "$(date +%s)"
if ! compose config --quiet; then
  install -m 0600 "${release_dir}/previous.env" "${release_env}"
  exit 6
fi

if deploy_release; then
  install -m 0600 "${release_env}" "${release_dir}/deployed.env"
  {
    printf 'deployed_at=%s\n' "$(date --utc --iso-8601=seconds)"
    printf 'deployed_by=%s\n' "${registry_user}"
    printf 'release_revision=%s\n' "${release_revision}"
    printf 'core_image=%s\n' "${candidate_core_image}"
    printf 'app_image=%s\n' "${candidate_app_image}"
    printf 'predeployment_backup=%s\n' "${predeployment_backup}"
  } >"${release_dir}/manifest.env"
  touch "${release_dir}/SUCCESS"
  logger -t new-api-deploy "deployed Core and App revision ${release_revision}"
  exit 0
fi

echo "candidate release failed health checks; rolling back Core and App" >&2
install -m 0600 "${release_dir}/previous.env" "${release_env}"
compose config --quiet
if deploy_release; then
  touch "${release_dir}/ROLLED_BACK"
  logger -p user.warning -t new-api-deploy \
    "rolled back Core and App after failed revision ${release_revision}"
  exit 7
fi

touch "${release_dir}/ROLLBACK_FAILED"
logger -p user.err -t new-api-deploy \
  "Core and App rollback failed after revision ${release_revision}"
exit 8
