# Include this fragment inside the public HTTPS server block.
# The `new_api_active` upstream is managed by new-api-deploy and points to the
# healthy blue or green Web/Gateway container. Include
# new-api-active-upstream.conf in Nginx's http context before using this block.
# The Web/Gateway routes API traffic to the matching color's Core container.

location / {
    proxy_pass http://new_api_active;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $http_connection;
    proxy_buffering off;
    proxy_request_buffering off;
}
